{
  "routes": [
    { "src": "/", "has": [{ "type": "host", "value": "sycstem.vercel.app" }], "dest": "/sycstem/index.html" },
    { "src": "/beta/?", "status": 307, "headers": { "Location": "/sycstem/" } },
    { "src": "/sycstem/og.png", "headers": { "Cache-Control": "public, max-age=86400" }, "continue": true },
    { "handle": "filesystem" }
  ]
}
