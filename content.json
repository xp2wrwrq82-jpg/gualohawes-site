 "plugins": {
  "FX": {
   "tag": "Every look, one panel.",
   "desc": "Fifty-three native effects — glitch, grain, chromatic, datamosh, bloom and beyond — grouped by feel and rendered in real time on your timeline. Pick a clip, dial the intensity, apply. No presets to hunt, no stacks to chain."
  },
  "SYNC": {
   "tag": "Cut to the beat, automatically.",
   "desc": "Point Sync at your rushes and every angle locks to the track through Premiere’s own sync engine. Multicam music videos assembled in minutes — on the downbeat, every time."
  },
  "GRADE": {
   "tag": "Reference in, grade out.",
   "desc": "Fourteen camera profiles and a Lab-space colour engine turn any footage into a finished look. Drop a reference frame, pull a LUT, match the whole timeline — cinema colour without the guesswork."
  },
  "TEXTURE": {
   "tag": "Analog soul on digital footage.",
   "desc": "Real-time grain, halation, dust and gate-weave layered straight onto your clips. The organic texture of film, controllable frame by frame, with none of the cleanup."
  },
  "FILMSTUDIO": {
   "tag": "Turn digital into celluloid.",
   "desc": "Emulated film stocks, fades and print looks built for narrative work. Choose a stock, set the fade, and your footage carries the depth and falloff of real film."
  }
 }
